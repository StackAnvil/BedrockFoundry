<!doctype html>
<html lang="en">
<meta charset="utf-8">
<title>Bedrock Foundry dependency licenses</title>
<style>body{max-width:70rem;margin:3rem auto;padding:0 1rem;font:16px/1.5 sans-serif}pre{white-space:pre-wrap}article{margin:3rem 0}</style>
<h1>Bedrock Foundry dependency licenses</h1>
<p>These dependencies retain their original licenses and copyright notices.</p>
{{#each licenses}}
<article>
<h2 id="{{id}}">{{name}}</h2>
<ul>
{{#each used_by}}
<li><a href="https://crates.io/crates/{{crate.name}}/{{crate.version}}">{{crate.name}} {{crate.version}}</a>{{#if crate.repository}}: <a href="{{crate.repository}}">source repository</a>{{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</article>
{{/each}}
</html>
